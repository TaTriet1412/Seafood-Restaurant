{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: start",
      "type": "shell",
      "command": "npm",
      "args": ["run", "start"],
      "options": {
        "cwd": "${workspaceFolder}/SeaFoodRestaurant(FE)/seafood-restaurant"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Building..." },
          "endsPattern": { "regexp": "(Local|Application bundle generation complete)" }
        }
      }
    }
  ]
}
