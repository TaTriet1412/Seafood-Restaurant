{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Frontend: Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "frontend: start",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/SeaFoodRestaurant(FE)/seafood-restaurant",
      "urlTimeout": 60000
    },
    {
      "name": "Backend: Spring Boot",
      "type": "java",
      "request": "launch",
      "mainClass": "com.example.Seafood_Restaurant.SeafoodRestaurantApplication",
      "projectName": "Seafood-Restaurant"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Frontend + Backend",
      "configurations": [
        "Backend: Spring Boot",
        "Frontend: Chrome"
      ]
    }
  ]
}
