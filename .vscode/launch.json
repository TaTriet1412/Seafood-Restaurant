{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Debug Spring Boot BE",
      "request": "launch",
      "mainClass": "com.example.Seafood_Restaurant.SeafoodRestaurantApplication",
      "projectName": "Seafood-Restaurant"
    },
    {
      "type": "chrome",
      "name": "Debug Angular FE",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/SeaFoodRestaurant(FE)/seafood-restaurant",
      "preLaunchTask": "Start Angular FE",
      "urlTimeout": 60000
    }
  ],
  "compounds": [
    {
      "name": "Run Fullstack",
      "configurations": ["Debug Spring Boot BE", "Debug Angular FE"]
    }
  ]
}
